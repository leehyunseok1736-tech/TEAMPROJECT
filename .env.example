# Google AI Studio에서 발급받은 Gemini API 키를 입력하세요. 실제 .env 파일은 Git에 포함되지 않습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 식약처 공공데이터포털 서비스 키입니다. 없으면 공식 품목 대조·DUR 점검을 건너뜁니다.
MFDS_API_KEY=
MFDS_PRODUCT_PATH=/DrugPrdtPrmsnInfoService07/getDrugPrdtPrmsnInq07
MFDS_DUR_PRODUCT_PATH=/DURPrdlstInfoService03/getDurPrdlstInfoList03

# Supabase Connect 화면의 Project URL과 Publishable key를 입력하세요.
# Secret key 또는 service_role key는 브라우저에 노출하면 안 됩니다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
