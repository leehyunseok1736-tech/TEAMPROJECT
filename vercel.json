{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "supabase-data.js",
          "manifest.webmanifest",
          "sw.js",
          "node_modules/@supabase/supabase-js/dist/umd/supabase.js",
          "icons/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
